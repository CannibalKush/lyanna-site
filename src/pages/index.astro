---
import '../styles/global.css';

const signals = [
  { label: 'making', value: 'small worlds' },
  { label: 'studying', value: 'the shape of attention' },
  { label: 'collecting', value: 'useful fragments' },
];

const notes = [
  { number: '01', title: 'A field guide to unfinished things', tag: 'notes', date: 'soon' },
  { number: '02', title: 'The soft machinery of a good day', tag: 'essay', date: 'soon' },
  { number: '03', title: 'On keeping a small internet', tag: 'dispatch', date: 'soon' },
];
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content="A small, luminous corner of the internet." />
    <meta name="theme-color" content="#11110f" />
    <title>field notes / a small internet</title>
  </head>
  <body>
    <div class="grain" aria-hidden="true"></div>
    <header class="site-header">
      <a class="wordmark" href="#top" aria-label="Return to top">lsv<span class="dot">·</span></a>
      <nav aria-label="Main navigation">
        <a href="#work">work</a>
        <a href="#notes">notes</a>
        <a href="#now">now</a>
      </nav>
      <span class="header-status"><i></i> online / curious</span>
    </header>

    <main id="top">
      <section class="hero section-wrap">
        <div class="hero-copy">
          <p class="eyebrow"><span>✳</span> personal field station / 2026</p>
          <h1>A small<br /><em>internet</em><br />of my own.</h1>
          <p class="hero-intro">A living archive of things made, noticed, and not yet understood.</p>
          <a class="text-link" href="#work">Enter the archive <span>↘</span></a>
        </div>
        <div class="orbital" aria-hidden="true">
          <div class="orbit orbit-one"></div>
          <div class="orbit orbit-two"></div>
          <div class="orbit orbit-three"></div>
          <div class="planet"><span></span></div>
          <div class="star star-a">✦</div>
          <div class="star star-b">·</div>
          <div class="star star-c">✧</div>
          <div class="orbital-label">keep<br />looking</div>
        </div>
      </section>

      <section class="signal-strip section-wrap" id="now" aria-label="Current signals">
        <p class="strip-label">current signals</p>
        <div class="signal-grid">
          {signals.map((signal) => (
            <div class="signal">
              <span>{signal.label}</span>
              <strong>{signal.value}</strong>
            </div>
          ))}
        </div>
      </section>

      <section class="work section-wrap" id="work">
        <div class="section-heading">
          <p class="eyebrow">01 / selected work</p>
          <p class="section-aside">things with a pulse<br />and a point of view</p>
        </div>
        <div class="work-grid">
          <article class="project project-large">
            <div class="project-art art-signal"><span>◌</span><b>FIELD<br />SIGNAL</b><i>↗</i></div>
            <div class="project-meta"><h2>Field Signal</h2><p>an instrument for finding the thread</p><span>2025 / digital object</span></div>
          </article>
          <article class="project">
            <div class="project-art art-moss"><span>✳</span><b>SOFT<br />SYSTEMS</b><i>↗</i></div>
            <div class="project-meta"><h2>Soft Systems</h2><p>tools for gentler futures</p><span>2024 / research & design</span></div>
          </article>
          <article class="project">
            <div class="project-art art-index"><span>∞</span><b>INDEX<br />OF AIR</b><i>↗</i></div>
            <div class="project-meta"><h2>Index of Air</h2><p>a catalogue of invisible weather</p><span>2023 / writing & code</span></div>
          </article>
        </div>
      </section>

      <section class="notes section-wrap" id="notes">
        <div class="section-heading">
          <p class="eyebrow">02 / notes from the edge</p>
          <a class="text-link" href="#notes">Read all <span>↘</span></a>
        </div>
        <div class="notes-list">
          {notes.map((note) => (
            <a class="note" href="#notes">
              <span class="note-number">{note.number}</span>
              <h2>{note.title}</h2>
              <span class="note-tag">{note.tag}</span>
              <span class="note-date">{note.date} <b>↗</b></span>
            </a>
          ))}
        </div>
      </section>

      <section class="closing section-wrap">
        <p class="eyebrow">03 / transmission</p>
        <h2>There is more<br /><em>to come.</em></h2>
        <p class="closing-copy">This place is still becoming. Return when the moon is in a different house.</p>
        <a class="button-link" href="mailto:hello@lyanna.dev">Send a signal <span>↗</span></a>
      </section>
    </main>

    <footer class="site-footer section-wrap">
      <span>© 2026 / lsv</span>
      <span>made slowly, on purpose</span>
      <span>↑ <a href="#top">back to orbit</a></span>
    </footer>

    <script>
      const status = document.querySelector('.header-status');
      const updateStatus = () => {
        if (status) status.innerHTML = `<i></i> ${window.scrollY > 80 ? 'in motion' : 'online / curious'}`;
      };
      window.addEventListener('scroll', updateStatus, { passive: true });
    </script>
  </body>
</html>
