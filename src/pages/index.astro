---
import '../styles/global.css';
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content="A small space for useful things." />
    <meta name="theme-color" content="#f3f1eb" />
    <link rel="canonical" href="https://www.lyanna.dev/" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://www.lyanna.dev/" />
    <meta property="og:title" content="lyanna.dev — soon" />
    <meta property="og:description" content="A small space for useful things." />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content="lyanna.dev — soon" />
    <meta name="twitter:description" content="A small space for useful things." />
    <title>lyanna.dev — soon</title>
  </head>
  <body>
    <header class="site-header">
      <a class="wordmark" href="/" aria-label="Lyanna home">lyanna<span>.</span>dev</a>
      <span class="status"><i aria-hidden="true"></i>under construction</span>
    </header>

    <main class="landing">
      <div class="signal" aria-hidden="true"><span></span></div>
      <p class="kicker">a personal site / 2026</p>
      <h1>A small space<br />for <em>useful things.</em></h1>
      <p class="intro">This place is taking shape. Come back soon.</p>
      <a class="contact" href="mailto:lysv.dev@gmail.com">Send a note <span aria-hidden="true">↗</span></a>
    </main>

    <footer class="site-footer">
      <span>lyanna.dev</span>
      <span>made slowly</span>
    </footer>
  </body>
</html>
